# ==============================================================================
# SmartCommute — Environment Configuration Example
# ==============================================================================
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# ==============================================================================

# OpenAI API Key (Optional)
# If provided, the AI Advisor ("How should I commute today?") uses OpenAI's
# gpt-4o-mini to generate personalized natural language commute recommendations.
#
# If left empty, SmartCommute automatically and gracefully falls back to the
# deterministic Zero-Config heuristic recommendation engine with identical response structure.
#
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
