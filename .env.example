# ==============================================================================
# SmartCommute — Environment Configuration Example
# ==============================================================================
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# ==============================================================================

# Google Gemini API Key (Recommended - Free Tier, No Credit Card Required)
# Generuj klucz 1 kliknięciem na: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI API Key (Optional)
# If provided, uses gpt-4o-mini: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude API Key (Optional)
# If provided, uses claude-3-5-haiku: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Docker Compose Port Overrides (Optional, defaults: 5173 for frontend, 8000 for backend)
# FRONTEND_PORT=5173
# BACKEND_PORT=8000

# Docker & Backend CORS Configuration (Optional)
# CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://127.0.0.1:5173
